  "description": "Check if a date falls on the Egyptian weekend (Friday/Saturday)",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "homepage": "https://github.com/mostafaabbas98/agaza#readme",
  "keywords": [
